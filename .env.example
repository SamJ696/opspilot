# Copy to .env and fill in the values you have. OpsPilot runs without these.

# Optional narration. Leave disabled for the deterministic demo.
OPSPILOT_ENABLE_LLM=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Switch external agent. Not used until the adapter is connected.
SWITCH_BASE_URL=
SWITCH_AGENT_ID=
SWITCH_API_KEY=
SWITCH_ROOM_ID=

# Storage. Defaults live under data/ when these are unset.
# OPSPILOT_DB_PATH=data/opspilot.db
# OPSPILOT_CHECKPOINT_PATH=data/checkpoints.sqlite
# OPSPILOT_RUNTIME_PATH=data/runtime/state.json
