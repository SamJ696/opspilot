# Optional narration. Leave disabled for the deterministic demo.
OPSPILOT_ENABLE_LLM=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Switch Agent Bridge (same host/port as your local Switch server unless configured otherwise)
SWITCH_AGENT_BRIDGE_URL=http://127.0.0.1:8080
SWITCH_GATEWAY_URL=http://127.0.0.1:8080

# External OpsPilot agent credentials (from registration)
SWITCH_AGENT_ID=
SWITCH_API_KEY=
SWITCH_ROOM_ID=
# Or comma-separated allowlist:
# SWITCH_ROOM_IDS=

# Registration helpers (not needed at runtime)
SWITCH_REGISTRATION_TOKEN=
SWITCH_GATEWAY_SESSION=
SWITCH_REGISTER_MODE=bridge
SWITCH_REGISTER_OVERWRITE=false
SWITCH_AGENT_NAME=opspilot

# Optional WebSocket tuning
# SWITCH_PROTOCOL_VERSION=9
# SWITCH_RECONNECT_DELAY_SECONDS=3
# SWITCH_CONNECTION_ID_PATH=data/runtime/switch_connection_id

# Storage defaults (under data/ when unset)
# OPSPILOT_DB_PATH=data/opspilot.db
# OPSPILOT_CHECKPOINT_PATH=data/checkpoints.sqlite
# OPSPILOT_RUNTIME_PATH=data/runtime/state.json
